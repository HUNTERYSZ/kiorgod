# Shared dashboard password
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Random secret, at least 32 chars
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token

# Vercel Cron secret
CRON_SECRET=replace-with-a-long-random-cron-secret

# (No DISCORD_BOT_TOKEN needed — tokens are stored per-entry in the UI)
